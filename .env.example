# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# Production values go into the hosting dashboard (Render) and GitHub Actions secrets.

# ---------------------------------------------------------------- process
APP_ENV=dev                      # dev | test | prod (prod refuses the dev admin token)
LOG_LEVEL=INFO
LOG_JSON=true
PORT=8000

# ---------------------------------------------------------------- storage
# Local compose values shown. Neon's "postgresql://...?sslmode=require" form is accepted as-is.
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay
# Upstash gives "rediss://default:<password>@<host>.upstash.io:6379" (TLS).
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- auth
# Bearer token for /admin/*. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=dev-admin-token
