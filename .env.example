# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# In production these are set in the hosting dashboard (Render) and GitHub Actions secrets.
# Every variable is optional unless marked REQUIRED IN PROD.

# ---------------------------------------------------------------- process
APP_ENV=dev                         # dev | test | prod (prod refuses the dev admin token)
LOG_LEVEL=INFO
LOG_JSON=true
PORT=8000
# REPLICA_ID=gateway-1              # defaults to the hostname (container id under compose)

# ---------------------------------------------------------------- storage (REQUIRED IN PROD)
# Local compose values shown. Neon's "postgresql://...?sslmode=require" form is accepted as-is.
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay
DATABASE_POOL_SIZE=10
DATABASE_POOL_PRE_PING=false          # true for Neon (suspended compute drops connections)
# Upstash gives "rediss://default:<password>@<host>.upstash.io:6379" (TLS).
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# ---------------------------------------------------------------- auth
# REQUIRED IN PROD. Bearer token for /admin/*.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=dev-admin-token
# Serve the read-only dashboard endpoints (usage, providers, alerts) without the admin token.
DASHBOARD_PUBLIC=false
API_KEY_CACHE_TTL_S=60

# ---------------------------------------------------------------- providers & routing
RELAY_CONFIG_FILE=config/relay.yaml
MOCK_PROVIDER_URL=http://localhost:9000
# Real providers light up when their key is set (see config/relay.yaml).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REQUEST_TIMEOUT_S=120

# ---------------------------------------------------------------- limits (defaults for new keys)
DEFAULT_RPM_LIMIT=60
DEFAULT_TPD_LIMIT=1000000
DEFAULT_COMPLETION_RESERVE_TOKENS=256
RATE_LIMIT_FAIL_OPEN=true

# ---------------------------------------------------------------- caching
CACHE_EXACT_ENABLED=true
CACHE_SEMANTIC_ENABLED=true
CACHE_TTL_S=3600
EMBEDDING_PROVIDER=hashing          # hashing | fastembed (EXTRAS=local-embeddings) | openai
# SEMANTIC_CACHE_THRESHOLD=0.88     # unset = the embedder's calibrated default
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- metering & alerts
USAGE_FLUSH_INTERVAL_S=1.0
USAGE_BATCH_SIZE=500
USAGE_RETENTION_DAYS=30
# Slack/Discord-compatible incoming webhook for 50/80/100% budget alerts.
BUDGET_ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------- demo
# A fixed key provisioned at startup with low limits (compose sets rk_local_dev_key).
DEMO_API_KEY=
DEMO_RPM_LIMIT=20
DEMO_TPD_LIMIT=200000
# Run the mock provider inside the gateway process (single-container deploys).
MOUNT_MOCK_PROVIDER=false
